      "walkthroughs": [
        {
          "id": "html-basic-page",
          "title": "見本コードの読み方",
          "lessons": [
            1
          ],
          "code": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>海のページ</title>\n</head>\n<body>\n  <p>青い海が好きです。</p>\n</body>\n</html>",
          "lines": [
            {
              "code": "<!DOCTYPE html>",
              "meaning": "「HTML5で書かれたページです」とブラウザに伝える宣言。いちばん最初に書く"
            },
            {
              "code": "<html lang=\"ja\">",
              "meaning": "ページ全体を囲む。lang=\"ja\" で日本語のページと伝える"
            },
            {
              "code": "<head>",
              "meaning": "ページの設定を書く場所。画面には表示されない"
            },
            {
              "code": "<meta charset=\"UTF-8\">",
              "meaning": "文字コードの指定。日本語の文字化けを防ぐ。閉じタグなし"
            },
            {
              "code": "<title>海のページ</title>",
              "meaning": "ブラウザのタブに表示されるページ名"
            },
            {
              "code": "</head>",
              "meaning": "headを閉じる"
            },
            {
              "code": "<body>",
              "meaning": "画面に見える内容を入れる場所"
            },
            {
              "code": "<p>青い海が好きです。</p>",
              "meaning": "段落。画面に「青い海が好きです。」と表示される"
            },
            {
              "code": "</body>",
              "meaning": "bodyを閉じる"
            },
            {
              "code": "</html>",
              "meaning": "htmlを閉じる(ページの終わり)"
            }
          ],
          "appearance": [
            {
              "where": "タブ",
              "shows": "海のページ",
              "from": "title"
            },
            {
              "where": "画面",
              "shows": "青い海が好きです。",
              "from": "body の中の p"
            }
          ],
          "summary": "headの中はページの情報、bodyの中は見えるもの。",
          "structure": "html\n├ head   ← 設定(見えない)\n│  ├ meta\n│  └ title\n└ body   ← 内容(見える)\n   └ p"
        }
      ]
    }
  ]
}